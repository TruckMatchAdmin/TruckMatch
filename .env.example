# TruckMatch - Environment Variables Example
# Duplicate this file to .env.local and fill in the values

# Supabase Public API (Accessible client-side)
NEXT_PUBLIC_SUPABASE_URL=https://azxwqcdnwkolodxwsqoq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Server-Only (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# App settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3005
