# ==============================================================
# TRUCKMATCH - FICHIER D'EXEMPLE DES VARIABLES D'ENVIRONNEMENT
# Ne jamais inclure de clés secrètes réelles dans ce fichier.
# Dupliquer vers .env.local sur votre environnement.
# ==============================================================

# 1. Supabase API Publique (Accessible côté client)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique

# 2. Supabase Service Role (Strictement côté serveur)
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_secrete
SUPABASE_ACCESS_TOKEN=votre_jeton_management_api

# 3. Paramètres du Serveur Web
NEXT_PUBLIC_SITE_URL=https://truckmatch.fr
PORT=3005
SESSION_SECRET=votre_secret_hmac_pour_les_cookies_de_session

# 4. Authentification Administrateur Unique
ADMIN_EMAIL=jobs@truckmatch.fr
ADMIN_PASSWORD=votre_mot_de_passe_administrateur_fort

# 5. Monitoring Telegram & Bot d'Administration
# Bot : @TruckMatchAdmin_bot (https://t.me/TruckMatchAdmin_bot)
TELEGRAM_BOT_TOKEN=votre_jeton_botfather_telegram
TELEGRAM_ADMIN_CHAT_ID=8376439336
TELEGRAM_WEBHOOK_SECRET=votre_secret_pour_proteger_le_webhook_telegram

# 6. Tâches Planifiées (Rapport statistique quotidien à 21h Europe/Paris)
CRON_SECRET=votre_secret_interne_declencheur_cron
